{
  "version": "2",
  "templates": [
    {
      "title": "HubMinimalWp",
      "description": "WhatsApp hub - 3 numara, QR, mesaj API → hubmsg.octotech.az",
      "platform": "docker",
      "image": "hubminimalwp:latest",
      "build": ".",
      "categories": ["misc"],
      "ports": [],
      "env": [
        {
          "name": "API_KEY",
          "label": "API Key (optional)",
          "default": ""
        },
        {
          "name": "TUNNEL_TOKEN",
          "label": "Cloudflare Tunnel Token (optional)",
          "default": ""
        }
      ],
      "network": "edge",
      "volumes": ["/datastore/hubminimal/data:/app/data"]
    }
  ]
}
