{
  "version": "2",
  "templates": [
    {
      "title": "HubMinimalWp",
      "description": "WhatsApp hub - 3 numara, QR, mesaj API → wa.octotech.az (Traefik :443)",
      "platform": "docker",
      "categories": ["misc"],
      "build": {
        "repository": "https://github.com/aliyabuz25/HubMSG-Mini.git",
        "path": ".",
        "dockerfile": "Dockerfile"
      },
      "ports": [],
      "env": [
        {
          "name": "API_KEY",
          "label": "API Key (optional)",
          "default": ""
        },
        {
          "name": "TUNNEL_TOKEN",
          "label": "Cloudflare Tunnel Token (optional)",
          "default": ""
        }
      ],
      "network": "edge",
      "volumes": ["/datastore/hubminimal/data:/app/data"]
    }
  ]
}
